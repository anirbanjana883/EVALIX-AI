generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER
}

enum AssignmentType {
  MCQ
  DESCRIPTIVE
}

enum AnswerStatus {
  PENDING
  EVALUATED
  FAILED
}

enum SubmissionStatus {
  PENDING
  PROCESSING // 🌟 NEW: Added for async background evaluation
  GRADED
  FAILED
}

// 🌟 NEW: For the RAG Vector Database
enum MaterialType {
  RUBRIC
  REFERENCE_ANSWER
  TEACHER_NOTES
  SYLLABUS
}

enum Department {
  COMPUTER_SCIENCE_ENGINEERING
  ELECTRONICS_AND_COMMUNICATION_ENGINEERING
  ELECTRICAL_AND_ELECTRONICS_ENGINEERING
  MECHANICAL_ENGINEERING
  CIVIL_ENGINEERING
  AUTOMOBILE_ENGINEERING
  CHEMICAL_ENGINEERING
  INFORMATION_TECHNOLOGY
  BIOTECHNOLOGY
  PETROLEUM_ENGINEERING
  AEROSPACE_ENGINEERING
  METALLURGICAL_ENGINEERING
  INDUSTRIAL_ENGINEERING
  ENVIRONMENTAL_ENGINEERING
  DATA_SCIENCE_ENGINEERING
  ARTIFICIAL_INTELLIGENCE_ENGINEERING
  ROBOTICS_ENGINEERING
}

enum AcademicYear {
  BTECH_YEAR_1
  BTECH_YEAR_2
  BTECH_YEAR_3
  BTECH_YEAR_4
  MTECH_YEAR_1
  MTECH_YEAR_2
}

enum Batch {
  BATCH_1
  BATCH_2
  BATCH_3
  BATCH_4
  BATCH_5
  BATCH_6
  BATCH_7
  BATCH_8
  BATCH_9
  BATCH_10
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id                  String        @id @db.Uuid 
  email               String        @unique
  name                String
  role                Role          @default(STUDENT)
  
  department          Department?
  year                AcademicYear?
  batch               Batch?
  university_roll     String?       @unique 
  registration_number String?       @unique 

  created_at          DateTime      @default(now())

  assignments         Assignment[]  @relation("TeacherAssignments")
  submissions         Submission[]

  @@map("users")
}

model Assignment {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  teacher_id       String         @db.Uuid
  title            String
  type             AssignmentType
  
  department       Department
  subject          String
  year             AcademicYear         
  batch            Batch

  start_time       DateTime       
  end_time         DateTime       
  release_marks_at DateTime       
  
  created_at       DateTime       @default(now())

  teacher          User                 @relation("TeacherAssignments", fields: [teacher_id], references: [id])
  questions        Question[]
  submissions      Submission[]
  materials        AssignmentMaterial[] // 🌟 NEW: RAG Materials link here

  @@map("assignments")
}

model Question {
  id              String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignment_id   String     @db.Uuid
  question_text   String     @db.Text
  image_url       String?    
  max_marks       Float
  
  model_answer    String?    @db.Text 
  
  mcq_options     Json?      
  mcq_answer      String?    
  mcq_explanation String?    @db.Text 

  assignment      Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@map("questions")
}

model Submission {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignment_id    String           @db.Uuid
  student_id       String           @db.Uuid
  
  total_score      Float?           
  status           SubmissionStatus @default(PENDING)
  submitted_at     DateTime         @default(now())

  // 🌟 NEW: Advanced Evaluation Flags
  plagiarism_score Float?
  confidence_score Float?
  requires_review  Boolean          @default(false)

  assignment       Assignment         @relation(fields: [assignment_id], references: [id])
  student          User               @relation(fields: [student_id], references: [id])
  answers          Answer[]         
  
  // 🌟 NEW: Workflow Relations
  plagiarism_reports PlagiarismReport[] @relation("SubmissionPlagiarism")
  matched_reports    PlagiarismReport[] @relation("MatchedPlagiarism")
  teacher_review     TeacherReview?

  @@unique([assignment_id, student_id])
  @@map("submissions")
}

model Answer {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  submission_id    String       @db.Uuid
  question_id      String       @db.Uuid
  
  // OCR & Image Details
  file_urls        String[]      
  ocr_text         String?      @db.Text
  embedding        Unsupported("vector(768)")?
  ocr_confidence   Float?       // 🌟 NEW: How sure is the AI about the handwriting?

  // Evaluation Details
  ai_feedback      String?      @db.Text 
  teacher_feedback String?      @db.Text 
  strengths        Json?        // 🌟 NEW: Structured feedback
  weaknesses       Json?        // 🌟 NEW: Structured feedback
  missing_concepts Json?        // 🌟 NEW: Structured feedback
  eval_confidence  Float?       // 🌟 NEW: How sure is the AI about the grade?
  flagged          Boolean      @default(false) // 🌟 NEW: Flag individual weird answers
  
  mcq_selected     String?      
  score            Float?
  status           AnswerStatus @default(PENDING)

  submission       Submission   @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question         Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, question_id])
  @@map("answers")
}

// -----------------------------------------------------------------------------
// 🌟 NEW RAG & PIPELINE MODELS
// -----------------------------------------------------------------------------

model AssignmentMaterial {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignment_id   String       @db.Uuid
  type            MaterialType
  content         String       @db.Text
  
  // Requires pgvector extension in Supabase!
  embedding       Unsupported("vector(768)")? 

  created_at      DateTime     @default(now())

  assignment      Assignment   @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@map("assignment_materials")
}

model PlagiarismReport {
  id                    String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  submission_id         String     @db.Uuid
  matched_submission_id String     @db.Uuid
  
  similarity_score      Float
  status                String

  created_at            DateTime   @default(now())

  submission            Submission @relation("SubmissionPlagiarism", fields: [submission_id], references: [id], onDelete: Cascade)
  matched_submission    Submission @relation("MatchedPlagiarism", fields: [matched_submission_id], references: [id], onDelete: Cascade)

  @@map("plagiarism_reports")
}

model TeacherReview {
  id                  String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  submission_id       String     @unique @db.Uuid
  
  ai_score            Float
  teacher_score       Float
  teacher_feedback    String     @db.Text
  final_score         Float

  created_at          DateTime   @default(now())

  submission          Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@map("teacher_reviews")
}