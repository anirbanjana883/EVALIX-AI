generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS (Strict Type Safety)
// -----------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER 
}

enum AssignmentType {
  MCQ
  DESCRIPTIVE
}

enum AnswerStatus {
  PENDING
  EVALUATED
  FAILED
}

enum SubmissionStatus {
  PENDING
  GRADED
  FAILED
}

// 1. Define the Enums
enum Department {
  COMPUTER_SCIENCE_ENGINEERING
  ELECTRONICS_AND_COMMUNICATION_ENGINEERING
  ELECTRICAL_AND_ELECTRONICS_ENGINEERING
  MECHANICAL_ENGINEERING
  CIVIL_ENGINEERING
  AUTOMOBILE_ENGINEERING
  CHEMICAL_ENGINEERING
  INFORMATION_TECHNOLOGY
  BIOTECHNOLOGY
  PETROLEUM_ENGINEERING
  AEROSPACE_ENGINEERING
  METALLURGICAL_ENGINEERING
  INDUSTRIAL_ENGINEERING
  ENVIRONMENTAL_ENGINEERING
  DATA_SCIENCE_ENGINEERING
  ARTIFICIAL_INTELLIGENCE_ENGINEERING
  ROBOTICS_ENGINEERING
}

enum AcademicYear {
  BTECH_YEAR_1
  BTECH_YEAR_2
  BTECH_YEAR_3
  BTECH_YEAR_4
  MTECH_YEAR_1
  MTECH_YEAR_2
}

enum Batch {
  BATCH_1
  BATCH_2
  BATCH_3
  BATCH_4
  BATCH_5
  BATCH_6
  BATCH_7
  BATCH_8
  BATCH_9
  BATCH_10
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  // Uses the exact Supabase Auth UUID
  id             String         @id @db.Uuid
  email          String         @unique
  name           String
  role           Role           @default(STUDENT)
  
  // Strict B2B Data (Notice year/batch are excluded to keep auth fluid!)
  department     Department?      
  
  created_at     DateTime       @default(now())
  
  // Relations
  assignments    Assignment[]   @relation("TeacherAssignments")
  submissions    Submission[]
  
  // (Removed ReferenceAnswers relation)

  @@map("users")
}

model Assignment {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  teacher_id       String         @db.Uuid
  title            String
  type             AssignmentType
  
  // Strict B2B Hierarchy using Enums
  department       Department
  year             AcademicYear         
  batch            Batch
  subject          String
  
  // Time-Lock Features
  start_time       DateTime       // When students can start uploading/answering
  end_time         DateTime       // Deadline for submissions
  release_marks_at DateTime       // When the Student Dashboard unlocks the results
  
  created_at       DateTime       @default(now())

  // Relations
  teacher          User           @relation("TeacherAssignments", fields: [teacher_id], references: [id])
  questions        Question[]
  submissions      Submission[]

  @@map("assignments")
}

model Question {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignment_id    String   @db.Uuid
  question_text    String   @db.Text
  image_url        String?  // 🌟 NEW: The optional image/diagram the teacher uploads
  max_marks        Float
  
  // 🌟 NEW: For Descriptive Assignments (Replaces rubric_json and ReferenceAnswer table)
  model_answer     String?  @db.Text 
  
  // For MCQ Assignments
  mcq_options      Json?    // Array of strings, e.g., ["A", "B", "C", "D"]
  mcq_answer       String?  // The correct option
  mcq_explanation  String?  @db.Text 

  // Relations
  assignment       Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  answers          Answer[]
  
  // (Removed ReferenceAnswers relation)

  @@map("questions")
}

model Submission {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignment_id String           @db.Uuid
  student_id    String           @db.Uuid
  
  // Scoring
  total_score   Float?           // Nullable because Descriptive tests take time to grade!
  status        SubmissionStatus @default(PENDING) // Strictly typed status
  
  submitted_at  DateTime         @default(now())

  // Relations
  assignment    Assignment       @relation(fields: [assignment_id], references: [id])
  student       User             @relation(fields: [student_id], references: [id])
  answers       Answer[]         // Properly linked to the Answer table

  @@unique([assignment_id, student_id]) // A student can only submit once!
  @@map("submissions")
}

model Answer {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  submission_id    String       @db.Uuid
  question_id      String       @db.Uuid
  
  // -- For Descriptive Exams --
  file_url         String?      // Nullable because MCQs don't have file uploads
  ocr_text         String?      @db.Text
  
  // 🌟 Replaced feedback_json with two distinct text fields
  ai_feedback      String?      @db.Text // The paragraph the AI writes
  teacher_feedback String?      @db.Text // The note the teacher leaves during an override
  
  // -- For MCQ Exams --
  mcq_selected     String?      // The option the student clicked
  
  // -- Scoring & Status --
  score            Float?
  status           AnswerStatus @default(PENDING)

  // Relations
  submission       Submission   @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question         Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, question_id])
  @@map("answers")
}